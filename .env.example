# Salin ke .env lalu isi nilaimu sendiri
PORT=4000
JWT_SECRET=devnotes-dev-secret-change-me
ADMIN_PASSWORD=admin123
# DB_PATH=server/devnotes.db
# UPLOAD_DIR=server/uploads
# URL publik aplikasi (untuk redirect OAuth Google Drive). Contoh: https://notes.example.com
# APP_BASE_URL=https://notes.example.com

# --- Frontend (build-time) ---
# Kunci layar setelah N detik tanpa aktivitas (0 = nonaktif). Default 60.
VITE_LOCK_IDLE_SECONDS=60
# Auto logout setelah N menit tanpa aktivitas. Default 15.
# VITE_SESSION_IDLE_MINUTES=15